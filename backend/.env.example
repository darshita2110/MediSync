PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/medisync
JWT_SECRET=a-long-random-secret-string
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production requires JWT_SECRET to contain at least 32 characters.
# Optional: isolate integration tests in a separate database. Tests create/drop
# only randomly named test schemas. Explicit TEST_DATABASE_URL is required remotely.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/medisync_test
# Optional: lowercase schema name shared by the API and migration commands.
DATABASE_SCHEMA=public
# Separate process: npm run worker. Default 30000ms after each completed tick.
# REMINDER_INTERVAL_MS=30000
# Browser client origins, separated by commas. Development defaults to the two
# local Flutter origins below; production defaults to no browser origins.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Android FCM delivery. Keep disabled until server credentials are ready.
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
# Server-only credential path. Never put this key in mobile assets or Git.
# GOOGLE_APPLICATION_CREDENTIALS=D:/apps/medisync/backend/credentials/firebase-service-account.json
